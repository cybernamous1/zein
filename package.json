{
  "name": "zein-e-services",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute zein-db --local --file=migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute zein-db --remote --file=migrations/0001_initial.sql",
    "test": "node --no-warnings tests/run.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261125.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}